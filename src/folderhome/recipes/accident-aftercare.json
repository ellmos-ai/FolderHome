  "steps": [
    {
      "step_ref": "contacts",
      "workflow_id": "contact-register",
      "expert_id": "communication_expert",
      "goal_en": "Read the responsible insurance contact out of the policy documents.",
      "goal_de": "Den zuständigen Versicherungskontakt aus den Policendokumenten lesen.",
      "request": {
        "source_resource_id": "insurance_documents",
        "state_resource_id": "contact_state",
        "area": "versicherungen",
        "recursive": true,
        "allow_sensitive_local_read": false
      }
    },
    {
      "step_ref": "letter",
      "workflow_id": "correspondence-studio",
      "expert_id": "communication_expert",
      "goal_en": "Render the claim letter locally from the controlled template.",
      "goal_de": "Das Schadensschreiben lokal aus der geprüften Vorlage erzeugen.",
      "request": {
        "request_resource_id": "letter_request",
        "designs_resource_id": "letter_designs",
        "templates_resource_id": "letter_templates",
        "output_resource_id": "claim_output",
        "output_basename": "Schadensmeldung"
      }
    },
    {
      "step_ref": "draft",
      "workflow_id": "mail-connector",
      "expert_id": "communication_expert",
      "goal_en": "Place exactly that letter as a draft in your own mailbox; nothing is sent.",
      "goal_de": "Genau dieses Schreiben als Entwurf im eigenen Postfach ablegen; es wird nichts gesendet.",
      "request": {
        "account_resource_id": "mail_draft_account",
        "request_resource_id": "letter_request",
        "designs_resource_id": "letter_designs",
        "templates_resource_id": "letter_templates",
        "planned_at": "2026-08-25T09:00:00+02:00"
      }
    },
    {
      "step_ref": "appointment",
      "workflow_id": "calendar-handoff",
      "expert_id": "communication_expert",
